// Academia — database schema.
//
// Stage 0 modelled identity. Stage 1 adds the permission catalog,
// role ↔ permission grants, and an audit trail for permission changes.
// Student/Teacher profile entities, courses, classes, materials, payments and
// settlements belong to later stages.
//
// The connection URL is supplied by `prisma7.config.ts` from the environment.
//
// Naming convention: tables and columns are snake_case in the database via @map
// and @@map, while the TypeScript client stays camelCase. PostgreSQL folds
// unquoted identifiers to lowercase, so a camelCase column has to be quoted in
// every hand-written query — during a restore, in psql, or from any reporting
// tool. Later stages must follow this convention.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors ROLES in @academia/shared. Both must change together.
enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMINISTRATIVE
  TEACHER
  STUDENT

  @@map("user_role")
}

/// GRANT or REVOKE against a role's permission set.
enum PermissionChangeType {
  GRANT
  REVOKE

  @@map("permission_change_type")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Always stored normalised (trimmed, lowercased) by the application layer.
  email String @unique @db.VarChar(254)
  name  String? @db.VarChar(120)

  /// Derived key produced by src/lib/password.ts. Never a plaintext password.
  passwordHash String @map("password_hash") @db.VarChar(255)

  role     Role    @default(STUDENT)
  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  permissionChangeAudits PermissionChangeAudit[]

  @@index([role])
  @@map("users")
}

/// A grantable (module, action) pair. Catalog rows are seeded by migration.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  module String @db.VarChar(64)
  action String @db.VarChar(32)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([module, action])
  @@map("permissions")
}

/// Links a Role to a Permission. ADMINISTRATIVE access is driven by this table.
model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  role         Role
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Append-only record of permission grant/revoke attempts for a target role.
model PermissionChangeAudit {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String @map("actor_user_id") @db.Uuid
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  /// Role whose grants were changed (today always ADMINISTRATIVE).
  targetRole Role @map("target_role")

  changeType PermissionChangeType @map("change_type")

  module String @db.VarChar(64)
  action String @db.VarChar(32)

  /// Domain outcome: created | exists | removed | missing.
  outcome String @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetRole, createdAt])
  @@map("permission_change_audits")
}
