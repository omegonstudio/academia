// Academia — database schema.
//
// Stage 0 modelled identity. Stage 1 adds the permission catalog,
// role ↔ permission grants, and an audit trail for permission changes.
// Stage 2 adds academic Student and Teacher profiles (1:1 with User).
// Stage 3–4: assignment, Course/Group, ScheduleOption, Enrollment, ClassSession.
// Stage 5B: Material (FILE|LINK) with S3-compatible private storage.
// Stage 6B-1: Finance foundation (Charge / Payment / Allocation / Settlement).
// Recurrence belongs to later increments.
//
// The connection URL is supplied by `prisma7.config.ts` from the environment.
//
// Naming convention: tables and columns are snake_case in the database via @map
// and @@map, while the TypeScript client stays camelCase. PostgreSQL folds
// unquoted identifiers to lowercase, so a camelCase column has to be quoted in
// every hand-written query — during a restore, in psql, or from any reporting
// tool. Later stages must follow this convention.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors ROLES in @academia/shared. Both must change together.
enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMINISTRATIVE
  TEACHER
  STUDENT

  @@map("user_role")
}

/// GRANT or REVOKE against a role's permission set.
enum PermissionChangeType {
  GRANT
  REVOKE

  @@map("permission_change_type")
}

/// FILE (private object storage) or LINK (external https URL).
enum MaterialKind {
  FILE
  LINK

  @@map("material_kind")
}

/// FILE starts PENDING until complete verifies the object; LINK is always READY.
enum MaterialUploadStatus {
  PENDING
  READY

  @@map("material_upload_status")
}

enum FinanceCurrency {
  ARS
  USD

  @@map("finance_currency")
}

enum ChargeStatus {
  OPEN
  PAID
  CANCELLED

  @@map("charge_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

enum PaymentProvider {
  MERCADOPAGO
  STRIPE
  MANUAL

  @@map("payment_provider")
}

/// ORIGINAL accrues teacher/academy share; REVERSAL negates a prior allocation (refund).
enum RevenueAllocationKind {
  ORIGINAL
  REVERSAL

  @@map("revenue_allocation_kind")
}

enum TeacherSettlementStatus {
  OPEN
  MARKED_PAID

  @@map("teacher_settlement_status")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Always stored normalised (trimmed, lowercased) by the application layer.
  email String @unique @db.VarChar(254)
  name  String? @db.VarChar(120)

  /// Derived key produced by src/lib/password.ts. Never a plaintext password.
  passwordHash String @map("password_hash") @db.VarChar(255)

  role     Role    @default(STUDENT)
  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  permissionChangeAudits PermissionChangeAudit[]
  student                Student?
  teacher                Teacher?
  materialsCreated       Material[]
  financeSettingsUpdates AcademyFinanceSettings[]
  chargesCreated         Charge[]                 @relation("ChargeCreatedBy")
  paymentsCreated        Payment[]                @relation("PaymentCreatedBy")
  notifications          Notification[]
  emailTemplatesUpdated  NotificationEmailTemplate[] @relation("EmailTemplateUpdatedBy")
  onlineCourseAccessesGranted OnlineCourseAccess[] @relation("OnlineCourseAccessGrantedBy")
  onlineLessonAssetsCreated   OnlineLessonAsset[]

  @@index([role])
  @@map("users")
}

/// In-app notification row. Email delivery is best-effort via Resend.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable event kind: USER_CREATED | TEACHER_ASSIGNED | CLASS_MEETING_LINK
  type    String  @db.VarChar(64)
  title   String  @db.VarChar(200)
  body    String  @db.VarChar(2000)
  payload Json?

  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Director-editable email copy for notification types (Resend body/subject).
model NotificationEmailTemplate {
  id String @id @default(uuid()) @db.Uuid

  /// USER_CREATED | TEACHER_ASSIGNED | CLASS_MEETING_LINK
  type    String @unique @db.VarChar(64)
  subject String @db.VarChar(200)
  body    String @db.VarChar(4000)

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  updatedBy       User?   @relation("EmailTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_email_templates")
}

/// A grantable (module, action) pair. Catalog rows are seeded by migration.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  module String @db.VarChar(64)
  action String @db.VarChar(32)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([module, action])
  @@map("permissions")
}

/// Academic student profile. 1:1 with a User that has role STUDENT.
model Student {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  firstName String @map("first_name") @db.VarChar(80)
  lastName  String @map("last_name") @db.VarChar(80)

  /// CEFR level (A1–C2), validated in the application layer.
  level String @db.VarChar(8)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacherAssignment TeacherAssignment?
  enrollments       Enrollment[]
  attendances       Attendance[]
  charges           Charge[]
  payments          Payment[]
  revenueAllocations RevenueAllocation[]
  onlineCourseAccesses OnlineCourseAccess[]
  onlineLessonProgress OnlineLessonProgress[]
  onlineQuizAttempts   OnlineQuizAttempt[]
  onlineSubmissions    OnlineLessonSubmission[]

  @@index([isActive])
  @@index([lastName, firstName])
  @@map("students")
}

/// Academic teacher profile. 1:1 with a User that has role TEACHER.
model Teacher {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  firstName String @map("first_name") @db.VarChar(80)
  lastName  String @map("last_name") @db.VarChar(80)

  /// CEFR teaching level (A1–C2), validated in the application layer.
  level String @db.VarChar(8)

  /// AVAILABLE | UNAVAILABLE | LIMITED — validated in the application layer.
  availability String @default("AVAILABLE") @db.VarChar(16)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentAssignments TeacherAssignment[]
  groups             Group[]
  revenueAllocations RevenueAllocation[]
  settlements        TeacherSettlement[]
  onlineCoursesAuthored OnlineCourse[]

  @@index([isActive])
  @@index([availability])
  @@index([lastName, firstName])
  @@map("teachers")
}

/// Current Student → Teacher link. One active teacher per student; no history yet.
model TeacherAssignment {
  id String @id @default(uuid()) @db.Uuid

  studentId String @unique @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  teacherId String @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId])
  @@map("teacher_assignments")
}

/// Academic offering. serviceType = duration; courseType = educational purpose.
model Course {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  /// REGULAR | TEACHER_TRAINING — validated in the application layer.
  courseType String @map("course_type") @db.VarChar(32)

  /// ONE_TO_ONE_60 | ONE_TO_ONE_90 | GROUP_120 — validated in the application layer.
  serviceType String @map("service_type") @db.VarChar(32)

  /// List price in minor units (#44). Null until the course is priced.
  amountMinor BigInt?          @map("amount_minor")
  currency    FinanceCurrency?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groups             Group[]
  materials          Material[]
  charges            Charge[]
  revenueAllocations RevenueAllocation[]

  @@index([isActive])
  @@index([name])
  @@index([courseType])
  @@index([serviceType])
  @@map("courses")
}

/// Cohort/instance of a Course. Current teacher and weekly slot via optional FKs.
model Group {
  id String @id @default(uuid()) @db.Uuid

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  name String @db.VarChar(120)

  teacherId String?  @map("teacher_id") @db.Uuid
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  scheduleOptionId String?         @map("schedule_option_id") @db.Uuid
  scheduleOption   ScheduleOption? @relation(fields: [scheduleOptionId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments   Enrollment[]
  classSessions ClassSession[]
  charges       Charge[]
  revenueAllocations RevenueAllocation[]

  @@index([courseId])
  @@index([teacherId])
  @@index([scheduleOptionId])
  @@index([isActive])
  @@map("groups")
}

/// Concrete class occurrence. Duration comes from Group → Course.serviceType.
model ClassSession {
  id String @id @default(uuid()) @db.Uuid

  groupId String @map("group_id") @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  /// Instant start/end (timestamptz). endAt must match Course duration.
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  /// Optional external meeting room URL (https). Manual; no provider integration.
  meetingUrl String? @map("meeting_url") @db.VarChar(2048)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendances Attendance[]
  notes       ClassNote[]
  materials   Material[]
  charges     Charge[]

  @@unique([groupId, startAt])
  @@index([groupId, startAt])
  @@index([isActive, startAt])
  @@index([isActive])
  @@map("class_sessions")
}

/// Teaching material: FILE (S3-compatible) or LINK (https). XOR Course/ClassSession.
model Material {
  id String @id @default(uuid()) @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.VarChar(1000)

  kind         MaterialKind
  uploadStatus MaterialUploadStatus @map("upload_status")

  mimeType         String? @map("mime_type") @db.VarChar(100)
  sizeBytes        Int?    @map("size_bytes")
  /// Opaque object key — never exposed via API responses.
  storageKey       String? @unique @map("storage_key") @db.VarChar(512)
  originalFilename String? @map("original_filename") @db.VarChar(255)
  externalUrl      String? @map("external_url") @db.VarChar(2048)

  courseId String? @map("course_id") @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  classSessionId String?       @map("class_session_id") @db.Uuid
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([courseId, isActive])
  @@index([classSessionId, isActive])
  @@index([createdByUserId])
  @@index([isActive, uploadStatus])
  @@map("materials")
}

/// Private text note for one ClassSession. Hard delete; no author in MVP.
model ClassNote {
  id String @id @default(uuid()) @db.Uuid

  classSessionId String       @map("class_session_id") @db.Uuid
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  content String @db.VarChar(4000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([classSessionId, createdAt])
  @@map("class_notes")
}

/// Student presence for one ClassSession. No soft delete — change status instead.
model Attendance {
  id String @id @default(uuid()) @db.Uuid

  classSessionId String       @map("class_session_id") @db.Uuid
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// PRESENT | ABSENT — validated in the application layer.
  status String @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([classSessionId, studentId])
  @@index([classSessionId])
  @@index([studentId])
  @@map("attendances")
}

/// Student membership in a Group. Soft-deactivate; max 15 active per group (domain).
model Enrollment {
  id String @id @default(uuid()) @db.Uuid

  groupId String @map("group_id") @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  charges Charge[]

  @@unique([groupId, studentId])
  @@index([groupId, isActive])
  @@index([studentId])
  @@map("enrollments")
}

/// Reusable weekly time slot for dropdown selection (not a ClassSession).
model ScheduleOption {
  id String @id @default(uuid()) @db.Uuid

  /// MONDAY…SUNDAY — validated in the application layer.
  day String @db.VarChar(16)

  /// HH:mm — validated in the application layer. No timezone.
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groups Group[]

  @@index([isActive])
  @@index([day, startTime])
  @@map("schedule_options")
}

/// Links a Role to a Permission. ADMINISTRATIVE access is driven by this table.
model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  role         Role
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Append-only record of permission grant/revoke attempts for a target role.
model PermissionChangeAudit {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String @map("actor_user_id") @db.Uuid
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  /// Role whose grants were changed (today always ADMINISTRATIVE).
  targetRole Role @map("target_role")

  changeType PermissionChangeType @map("change_type")

  module String @db.VarChar(64)
  action String @db.VarChar(32)

  /// Domain outcome: created | exists | removed | missing.
  outcome String @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetRole, createdAt])
  @@map("permission_change_audits")
}

/// Singleton-style current academy revenue split (#41 / #44). teacher% is derived.
model AcademyFinanceSettings {
  id String @id @default(uuid()) @db.Uuid

  /// Allowed: 20 | 30 | 40 | 50. Enforced in domain + DB check.
  academyPercentage Int @map("academy_percentage")

  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("academy_finance_settings")
}

/// Student commercial obligation. Price snapshot is immutable after create (#44).
model Charge {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  amountMinor BigInt          @map("amount_minor")
  currency    FinanceCurrency
  status      ChargeStatus    @default(OPEN)

  courseId String? @map("course_id") @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  enrollmentId String?     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  classSessionId String?       @map("class_session_id") @db.Uuid
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  /// Online-course product charge (async LMS). Distinct from live Course.
  onlineCourseId String?       @map("online_course_id") @db.Uuid
  onlineCourse   OnlineCourse? @relation(fields: [onlineCourseId], references: [id], onDelete: Restrict)

  onlineCourseAccessId String?            @map("online_course_access_id") @db.Uuid
  onlineCourseAccess   OnlineCourseAccess? @relation(fields: [onlineCourseAccessId], references: [id], onDelete: Restrict)

  description String? @db.VarChar(500)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("ChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// GROUP_120 calendar-month window (date-only). Null for ONE_TO_ONE.
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments           Payment[]
  revenueAllocations RevenueAllocation[]

  /// Partial unique indexes (NULLs excluded) live in migration
  /// `20260925230000_charge_commercial_unique` — one Charge per ClassSession
  /// and one Charge per Enrollment+period. Prisma cannot express WHERE NOT NULL.
  @@index([studentId, status])
  @@index([courseId])
  @@index([groupId])
  @@index([enrollmentId])
  @@index([classSessionId])
  @@index([onlineCourseId])
  @@index([onlineCourseAccessId])
  @@index([status])
  @@map("charges")
}

/// Money movement for exactly one Charge (MVP 1:1). Snapshot amount/currency.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  chargeId String @unique @map("charge_id") @db.Uuid
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  amountMinor BigInt          @map("amount_minor")
  currency    FinanceCurrency
  status      PaymentStatus   @default(PENDING)
  provider    PaymentProvider

  providerPaymentId String? @map("provider_payment_id") @db.VarChar(191)
  idempotencyKey    String  @unique @map("idempotency_key") @db.VarChar(191)

  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy       User?   @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refunds            Refund[]
  revenueAllocations RevenueAllocation[]

  @@index([studentId, status])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

/// Frozen academy/teacher split. ORIGINAL on Payment SUCCEEDED; REVERSAL on total refund.
/// Unique (paymentId, kind) — one ORIGINAL and at most one REVERSAL per payment.
model RevenueAllocation {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  chargeId String @map("charge_id") @db.Uuid
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  courseId String? @map("course_id") @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  kind RevenueAllocationKind

  amountMinor         BigInt          @map("amount_minor")
  currency            FinanceCurrency
  academyPercentage   Int             @map("academy_percentage")
  academyAmountMinor  BigInt          @map("academy_amount_minor")
  teacherAmountMinor  BigInt          @map("teacher_amount_minor")

  /// Set only for REVERSAL rows (links to Refund).
  refundId String? @unique @map("refund_id") @db.Uuid
  refund   Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([paymentId, kind])
  @@index([teacherId, createdAt])
  @@index([studentId])
  @@index([chargeId])
  @@index([kind])
  @@map("revenue_allocations")
}

/// Total refund of a Payment. Partial refund is out of MVP.
model Refund {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @unique @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  amountMinor BigInt          @map("amount_minor")
  currency    FinanceCurrency
  reason      String?         @db.VarChar(500)

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  revenueAllocation RevenueAllocation?

  @@map("refunds")
}

/// Period owed vs marked-paid for a teacher (no bank payout in MVP).
model TeacherSettlement {
  id String @id @default(uuid()) @db.Uuid

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  totalTeacherAmountMinor BigInt                   @map("total_teacher_amount_minor")
  currency                FinanceCurrency
  status                  TeacherSettlementStatus  @default(OPEN)

  markedPaidAt DateTime? @map("marked_paid_at") @db.Timestamptz(3)
  note         String?   @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teacherId, periodStart, periodEnd, currency])
  @@index([teacherId, status])
  @@index([status])
  @@map("teacher_settlements")
}

/// Provider webhook inbox for Stage 6B-2. Idempotent on (provider, providerEventId).
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  provider         PaymentProvider
  providerEventId  String          @map("provider_event_id") @db.VarChar(191)
  payload          Json
  processedAt      DateTime?       @map("processed_at") @db.Timestamptz(3)
  error            String?         @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([createdAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Online courses (async LMS) — distinct from live Course → Group → ClassSession.
// ---------------------------------------------------------------------------

enum OnlineCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("online_course_status")
}

enum OnlineCourseAccessMode {
  OPEN
  LINEAR

  @@map("online_course_access_mode")
}

enum OnlineLessonStatus {
  DRAFT
  PUBLISHED

  @@map("online_lesson_status")
}

/// VIDEO | DOCUMENT | TEXT | LINK — extensible via app validation.
enum OnlineLessonAssetKind {
  VIDEO
  DOCUMENT
  TEXT
  LINK

  @@map("online_lesson_asset_kind")
}

enum OnlineLessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("online_lesson_progress_status")
}

enum OnlineQuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT

  @@map("online_quiz_question_type")
}

enum OnlineSubmissionStatus {
  SUBMITTED
  REVIEWED

  @@map("online_submission_status")
}

/// Async learning product. Not the live `Course` (serviceType / ClassSession).
model OnlineCourse {
  id String @id @default(uuid()) @db.Uuid

  title       String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(120)
  subtitle    String? @db.VarChar(300)
  description String? @db.VarChar(10000)

  authorTeacherId String?  @map("author_teacher_id") @db.Uuid
  authorTeacher   Teacher? @relation(fields: [authorTeacherId], references: [id], onDelete: SetNull)

  /// HTTPS cover URL (public marketing image). Private files use asset storage.
  coverImageUrl String? @map("cover_image_url") @db.VarChar(2048)

  /// JSON string arrays for marketing bullets.
  benefits Json?
  bonus    Json?

  status     OnlineCourseStatus     @default(DRAFT)
  accessMode OnlineCourseAccessMode @default(OPEN) @map("access_mode")

  certificateEnabled Boolean @default(false) @map("certificate_enabled")

  /// List price in minor units (#44). Null or 0 = free when published.
  amountMinor BigInt?          @map("amount_minor")
  currency    FinanceCurrency?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  modules  OnlineCourseModule[]
  accesses OnlineCourseAccess[]
  charges  Charge[]

  @@index([status, isActive])
  @@index([authorTeacherId])
  @@map("online_courses")
}

model OnlineCourseModule {
  id String @id @default(uuid()) @db.Uuid

  onlineCourseId String       @map("online_course_id") @db.Uuid
  onlineCourse   OnlineCourse @relation(fields: [onlineCourseId], references: [id], onDelete: Restrict)

  title       String  @db.VarChar(200)
  description String? @db.VarChar(2000)
  position    Int

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessons OnlineLesson[]

  @@index([onlineCourseId, position])
  @@index([onlineCourseId, isActive])
  @@map("online_course_modules")
}

model OnlineLesson {
  id String @id @default(uuid()) @db.Uuid

  moduleId String             @map("module_id") @db.Uuid
  module   OnlineCourseModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  title            String  @db.VarChar(200)
  description      String? @db.VarChar(2000)
  position         Int
  estimatedMinutes Int?    @map("estimated_minutes")
  isRequired       Boolean @default(true) @map("is_required")
  status           OnlineLessonStatus @default(DRAFT)

  /// When true, students may submit text/files for this lesson.
  acceptsSubmission Boolean @default(false) @map("accepts_submission")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets      OnlineLessonAsset[]
  quiz        OnlineQuiz?
  progress    OnlineLessonProgress[]
  submissions OnlineLessonSubmission[]

  @@index([moduleId, position])
  @@index([moduleId, isActive])
  @@map("online_lessons")
}

/// Content block inside a lesson. FILE-like assets reuse Material storage patterns.
model OnlineLessonAsset {
  id String @id @default(uuid()) @db.Uuid

  lessonId String       @map("lesson_id") @db.Uuid
  lesson   OnlineLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  kind     OnlineLessonAssetKind
  title    String @db.VarChar(200)
  position Int

  /// TEXT body (sanitised HTML/plain). Null for non-TEXT kinds.
  bodyText String? @map("body_text") @db.VarChar(50000)

  /// VIDEO/LINK external https URL, or VIDEO provider embed URL.
  externalUrl String? @map("external_url") @db.VarChar(2048)

  uploadStatus     MaterialUploadStatus? @map("upload_status")
  mimeType         String?               @map("mime_type") @db.VarChar(100)
  sizeBytes        Int?                  @map("size_bytes")
  storageKey       String?               @unique @map("storage_key") @db.VarChar(512)
  originalFilename String?               @map("original_filename") @db.VarChar(255)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId, position])
  @@index([lessonId, isActive])
  @@map("online_lesson_assets")
}

/// Student entitlement to an online course. Distinct from Group Enrollment.
model OnlineCourseAccess {
  id String @id @default(uuid()) @db.Uuid

  onlineCourseId String       @map("online_course_id") @db.Uuid
  onlineCourse   OnlineCourse @relation(fields: [onlineCourseId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  isActive  Boolean   @default(true) @map("is_active")
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  grantedByUserId String? @map("granted_by_user_id") @db.Uuid
  grantedBy       User?   @relation("OnlineCourseAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  charges Charge[]

  @@unique([onlineCourseId, studentId])
  @@index([studentId, isActive])
  @@index([onlineCourseId, isActive])
  @@map("online_course_accesses")
}

model OnlineLessonProgress {
  id String @id @default(uuid()) @db.Uuid

  lessonId String       @map("lesson_id") @db.Uuid
  lesson   OnlineLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  status OnlineLessonProgressStatus @default(NOT_STARTED)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  scorePercent Int?     @map("score_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonId, studentId])
  @@index([studentId, status])
  @@map("online_lesson_progress")
}

model OnlineQuiz {
  id String @id @default(uuid()) @db.Uuid

  lessonId String       @unique @map("lesson_id") @db.Uuid
  lesson   OnlineLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  title              String  @db.VarChar(200)
  passScorePercent   Int?    @map("pass_score_percent")
  isActive           Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions OnlineQuizQuestion[]
  attempts  OnlineQuizAttempt[]

  @@map("online_quizzes")
}

model OnlineQuizQuestion {
  id String @id @default(uuid()) @db.Uuid

  quizId String     @map("quiz_id") @db.Uuid
  quiz   OnlineQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  prompt   String                @db.VarChar(2000)
  type     OnlineQuizQuestionType
  position Int
  points   Int                   @default(1)
  /// SHORT_TEXT expected answer (case-insensitive trim match). Null otherwise.
  correctText String?            @map("correct_text") @db.VarChar(500)
  explanation String?            @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options OnlineQuizOption[]

  @@index([quizId, position])
  @@map("online_quiz_questions")
}

model OnlineQuizOption {
  id String @id @default(uuid()) @db.Uuid

  questionId String             @map("question_id") @db.Uuid
  question   OnlineQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label      String  @db.VarChar(1000)
  position   Int
  isCorrect  Boolean @default(false) @map("is_correct")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([questionId, position])
  @@map("online_quiz_options")
}

model OnlineQuizAttempt {
  id String @id @default(uuid()) @db.Uuid

  quizId String     @map("quiz_id") @db.Uuid
  quiz   OnlineQuiz @relation(fields: [quizId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  scorePercent Int     @map("score_percent")
  passed       Boolean
  /// Student answers + per-question results (server-evaluated).
  answersJson  Json    @map("answers_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quizId, studentId, createdAt])
  @@index([studentId])
  @@map("online_quiz_attempts")
}

model OnlineLessonSubmission {
  id String @id @default(uuid()) @db.Uuid

  lessonId String       @map("lesson_id") @db.Uuid
  lesson   OnlineLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  bodyText String?                @map("body_text") @db.VarChar(10000)
  status   OnlineSubmissionStatus @default(SUBMITTED)
  feedback String?                @db.VarChar(2000)

  /// Optional private file (same storage pattern as materials).
  uploadStatus     MaterialUploadStatus? @map("upload_status")
  mimeType         String?               @map("mime_type") @db.VarChar(100)
  sizeBytes        Int?                  @map("size_bytes")
  storageKey       String?               @unique @map("storage_key") @db.VarChar(512)
  originalFilename String?               @map("original_filename") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId, studentId])
  @@index([studentId])
  @@map("online_lesson_submissions")
}
