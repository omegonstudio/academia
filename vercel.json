{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build -w @academia/shared && npm run build -w @academia/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build -w @academia/shared && npm run build -w @academia/api",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
