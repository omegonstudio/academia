# =============================================================================
# Academia — environment template
# =============================================================================
# Copy to `.env` for local development:
#     cp .env.example .env
#
# RULES
#   - This file is committed. It must NEVER contain a real secret.
#   - `.env` and `.env.*` are gitignored (except this file).
#   - Development and production must never share a database, secret, API key,
#     payment credential, JWT/session secret, storage credential, or user data.
#   - DEV never uses the PROD database. PROD never uses the DEV database.
#
# Generate strong local secrets with:
#     openssl rand -base64 48
#
# Compose interpolates $VAR and ${VAR} inside .env values. A literal dollar
# sign must be written as $$. openssl rand -base64 never emits $, so the
# recommended generator is safe; do not paste a password that contains $
# without escaping it, or Compose will rewrite the secret (silently when the
# referenced name exists in the environment, with a warning when it does not).
# =============================================================================
#
# ENVIRONMENTS (hosted)
# ---------------------
# | Entorno | Rama  | Frontend     | API      | DB              | Storage        |
# | ------- | ----- | ------------ | -------- | --------------- | -------------- |
# | DEV     | `dev` | Vercel       | API DEV  | PostgreSQL DEV  | bucket/prefix DEV |
# | PROD    | `main`| DigitalOcean | API PROD | PostgreSQL PROD | bucket/prefix PROD |
#
# Local Docker Compose remains the day-to-day developer loop (below).
# Hosted DEV/PROD values are set in Vercel / the API host / DigitalOcean —
# never committed here.
#
# Who consumes which variables
# ----------------------------
# WEB (Next.js):  WEB_PORT, NEXT_PUBLIC_APP_URL, API_INTERNAL_URL
# API (Express):  everything else (DATABASE_*, AUTH_*, CORS_*, S3_*, bootstrap,
#                 ACADEMY_TIMEZONE, payments later, …)
# The web process must NEVER receive DATABASE_URL, AUTH_SECRET, or S3 secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime (local Compose defaults = DEV)
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# The Compose project name isolates volumes and networks per environment.
# scripts/compose.sh exports academia-dev / academia-prod for npm scripts.
# For bare `docker compose up` to match the development pair, set:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROJECT_NAME=academia-dev
# To run an extra stack side by side with the scripts, export ACADEMIA_PROJECT
# for that one command instead of changing COMPOSE_PROJECT_NAME permanently.

# -----------------------------------------------------------------------------
# PostgreSQL — API only (DEV ≠ PROD)
# -----------------------------------------------------------------------------
# Local Compose DEV database. Production uses a separate instance and credentials.
POSTGRES_DB=academia_dev
POSTGRES_USER=academia
# Local development password. Use a real secret in production.
POSTGRES_PASSWORD=change-me-locally

# Host port for the local DEV database. 5433 avoids clashing with a local
# PostgreSQL already listening on 5432. Production Compose does not publish DB.
POSTGRES_PORT=5433

# Used ONLY by host-side tooling, e.g. `npm run db:migrate` run from your shell.
# It therefore points at localhost:${POSTGRES_PORT}.
#
# Containers do not use this value: docker-compose.yml derives their
# DATABASE_URL from the POSTGRES_* variables above and targets the `db` service
# on port 5432. Those variables are the single source of truth for credentials.
DATABASE_URL=postgresql://academia:change-me-locally@localhost:5433/academia_dev?schema=public

# -----------------------------------------------------------------------------
# API (Node.js) — secrets and server config
# -----------------------------------------------------------------------------
API_PORT=4000

# Signs session cookies. MUST be at least 32 characters.
# MUST be different in development and production.
AUTH_SECRET=development-only-secret-change-me-32-chars-min

# Session lifetime in seconds (default 604800 = 7 days).
AUTH_SESSION_TTL=604800

# Comma-separated browser origins allowed to call the API *directly*.
# Leave empty when the browser reaches the API through the Next.js `/api`
# proxy (local Compose and Vercel DEV). Never use `*`: responses carry
# credentials. Only set explicit origins if the API is ever exposed on its
# own hostname to browsers.
CORS_ALLOWED_ORIGINS=

# Academy business IANA timezone. ScheduleOption times are local to this zone;
# ClassSession stores absolute timestamptz. Not a secret.
ACADEMY_TIMEZONE=America/Argentina/Buenos_Aires

# OpenAPI + Swagger UI. Optional.
# Unset → enabled in development/test, disabled in production.
# Set true|false to force either state (never expose docs publicly without intent).
# API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# Web (Next.js) — no DB / Auth / S3 secrets here
# -----------------------------------------------------------------------------
WEB_PORT=3000

# Public canonical origin. Used for SEO metadata, sitemap and canonical URLs.
# Build-time for NEXT_PUBLIC_* (rebuild after changing).
# Local: http://localhost:3000
# Vercel DEV: https://<your-vercel-deployment>.vercel.app (or custom DEV domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side address the Next.js server uses to reach the API (runtime only).
# NEVER expose this via NEXT_PUBLIC_*. The browser talks to same-origin `/api/*`;
# the Route Handler proxies with this URL.
#
# Local Compose: http://api:4000 (service name)
# Host Next against local API: http://localhost:4000
# Vercel DEV: https://<api-dev-host>  (API DEV reachable from Vercel)
# Production Compose / DigitalOcean: http://api:4000 (internal network)
API_INTERNAL_URL=http://api:4000

# -----------------------------------------------------------------------------
# SuperAdmin bootstrap (technical administration) — API only
# -----------------------------------------------------------------------------
# Provisioned idempotently at startup. If the account already exists, its role
# is re-asserted but the password is never overwritten.
# If SUPERADMIN_PASSWORD is unset, bootstrap is skipped (it never fails a deploy).
SUPERADMIN_EMAIL=omegon.info@gmail.com
SUPERADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Director bootstrap (academy operations) — API only
# -----------------------------------------------------------------------------
# Same rules as SuperAdmin. Never demotes SUPER_ADMIN if emails collide.
# If DIRECTOR_PASSWORD is unset, bootstrap is skipped (it never fails a deploy).
DIRECTOR_EMAIL=saragarfu@gmail.com
DIRECTOR_PASSWORD=

# Loads development-only sample data. MUST stay false in production.
# Hosted API DEV may set true for demos; production must refuse to start if true.
LOAD_SEED_DATA=false

# -----------------------------------------------------------------------------
# Object storage (S3-compatible) — API only — DEV ≠ PROD
# -----------------------------------------------------------------------------
# Local Compose: MinIO (`--profile materials`). Host tooling may use
# http://127.0.0.1:9000; the API container is wired to http://minio:9000 in
# docker-compose.dev.yml.
#
# Hosted DEV: separate Spaces (or S3) bucket/prefix, e.g. academia-materials-dev
# Production: separate Spaces bucket/prefix, e.g. academia-materials-prod
# Never reuse PROD keys or buckets from DEV (or the reverse).
#
# These are NOT real secrets. Replace in hosted environments. Never commit
# Spaces keys.
S3_ENDPOINT=http://127.0.0.1:9000
# Optional. Presigned URL origin for browsers. Unset in production Spaces.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=academia-materials
S3_REGION=us-east-1
S3_ACCESS_KEY=academia-dev-access-key
S3_SECRET_KEY=academia-dev-secret-key
# true for MinIO; typically false for DigitalOcean Spaces
S3_FORCE_PATH_STYLE=true

# Optional overrides (defaults: PDF 20MB, IMAGE 5MB, AUDIO 30MB)
# MATERIAL_MAX_PDF_BYTES=20971520
# MATERIAL_MAX_IMAGE_BYTES=5242880
# MATERIAL_MAX_AUDIO_BYTES=31457280
# MATERIAL_UPLOAD_URL_TTL_SECONDS=900
# MATERIAL_DOWNLOAD_URL_TTL_SECONDS=120

# MinIO console (local development only — not used by the API)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=academia-dev-access-key
MINIO_ROOT_PASSWORD=academia-dev-secret-key

# =============================================================================
# HOSTED DEV checklist (not loaded by local Compose — configure out of band)
# =============================================================================
# Vercel project (Root Directory = apps/web) — WEB DEV only:
#   NEXT_PUBLIC_APP_URL=https://<vercel-dev-host>
#   API_INTERNAL_URL=https://<api-dev-host>     # server-only; must reach API DEV
#   (do NOT set DATABASE_URL, AUTH_SECRET, or S3_* on the web project)
#
# API DEV host (Docker / VPS — not Vercel in this architecture):
#   NODE_ENV=production                         # Secure cookies behind HTTPS front
#   DATABASE_URL=postgresql://…@<postgres-dev>/academia_dev?schema=public
#   AUTH_SECRET=<openssl rand -base64 48>       # DEV-only secret
#   CORS_ALLOWED_ORIGINS=                       # empty while using Next proxy
#   S3_* pointing at the DEV bucket/prefix
#   SUPERADMIN_* / DIRECTOR_* / LOAD_SEED_DATA as needed for demos
#   ACADEMY_TIMEZONE=America/Argentina/Buenos_Aires
#
# =============================================================================
# PRODUCTION checklist (DigitalOcean — future; never share with DEV)
# =============================================================================
# WEB + API on the same private network (Compose prod / future DO):
#   NEXT_PUBLIC_APP_URL=https://<production-host>
#   API_INTERNAL_URL=http://api:4000
#   DATABASE_URL / POSTGRES_* → PostgreSQL PROD only
#   AUTH_SECRET → PROD-only (≥32 chars, not the sample)
#   S3_* → PROD Spaces bucket/prefix + live keys
#   LOAD_SEED_DATA=false
#   CORS_ALLOWED_ORIGINS=                       # empty with same-origin proxy
#
# =============================================================================
# NOT WIRED YET — reserved names for later stages. Do not implement early.
# =============================================================================
# Stage 6 — Payments. Argentina via Mercado Pago, international via Stripe.
# Both sit behind the Payment Domain; never called from the frontend directly.
# Use sandbox/test credentials in DEV; live credentials only in PROD.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
